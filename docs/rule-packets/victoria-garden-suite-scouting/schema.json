{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QuinnPaterson96/ShovelReady/blob/main/docs/rule-packets/victoria-garden-suite-scouting/schema.json",
  "title": "Victoria garden-suite scouting candidate v1",
  "type": "object",
  "required": ["schema_version", "packet_id", "packet_revision", "status", "assessment_dimensions", "source", "scope", "definitions", "rules", "outstanding_checks"],
  "properties": {
    "schema_version": {"const": "victoria-garden-suite-scouting.candidate.v1"},
    "packet_id": {"type": "string", "minLength": 1},
    "packet_revision": {"type": "string", "minLength": 1},
    "status": {"const": "agent_mapped_unreviewed_unpublished"},
    "assessment_dimensions": {"type": "object", "required": ["rule_text", "applicability", "site_input_quality"]},
    "source": {
      "type": "object",
      "required": ["provider", "instrument", "url", "captured_at_utc", "sha256", "bytes", "pages", "revision_evidence", "effective_from", "effective_to", "independent_source_review", "accepted_release_id"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "pages": {"type": "integer", "minimum": 1},
        "independent_source_review": {"const": "pending"},
        "accepted_release_id": {"type": "null"},
        "effective_from": {"type": "null"},
        "effective_to": {"type": "null"}
      }
    },
    "scope": {"type": "object", "required": ["jurisdiction", "pathway", "not_complete_by_law_review", "required_applicability_inputs", "unsupported_exception_codes"], "properties": {"not_complete_by_law_review": {"const": true}}},
    "definitions": {"type": "object"},
    "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}},
    "outstanding_checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "locator", "reason", "next_action"]}}
  },
  "$defs": {
    "quantity": {
      "type": "object",
      "required": ["value", "unit", "dimension"],
      "properties": {
        "value": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        "unit": {"enum": ["m", "m2", "count"]},
        "dimension": {"enum": ["length", "area", "count"]}
      }
    },
    "rule": {
      "type": "object",
      "required": ["logical_rule_id", "proposed_revision_id", "kind", "source_locators", "operator", "original", "normalized", "measurement_basis", "required_inputs", "explanation", "support"],
      "properties": {
        "logical_rule_id": {"type": "string", "pattern": "^victoria-zb2018-garden-suite-"},
        "proposed_revision_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["prerequisite", "scalar_bound", "minimum_distance", "minimum_distance_per_edge"]},
        "source_locators": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "operator": {"enum": ["all_true", "<=", ">="]},
        "original": {"oneOf": [{"type": "string"}, {"type": "object", "required": ["value", "unit"]}]},
        "normalized": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"type": "object", "required": ["required_values"]}]},
        "measurement_basis": {"type": "string", "minLength": 1},
        "required_inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "explanation": {"type": "string", "minLength": 1},
        "support": {"enum": ["conditional_comparison_only", "conditional_comparison_after_measurement_review"]},
        "exception_codes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
