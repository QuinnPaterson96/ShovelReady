        "status": {
          "enum": [
            "known",
            "missing",
            "uncertain"
          ],
          "title": "Status",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "identity",
        "inputs",
        "definition",
        "status",
        "quantity",
        "provenance"
      ],
      "title": "MeasuredFact",
      "type": "object"
    },
