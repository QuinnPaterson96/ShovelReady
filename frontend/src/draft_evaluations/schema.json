      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "manufacturer_interior_area",
            "nominal_exterior_width",
            "nominal_exterior_depth",
            "ceiling_height",
            "roof_height",
            "occupancy_footprint",
            "regulatory_floor_area",
            "regulatory_height",
            "lot_area",
            "lot_width",
            "lot_depth",
            "storeys",
            "dwelling_units"
