        "lot_line_classification": {
          "anyOf": [
            {
              "enum": [
                "front",
                "rear",
                "interior_side",
                "exterior_side",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lot Line Classification"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "fact_id",
        "role",
        "status",
        "geometry",
        "provenance"
