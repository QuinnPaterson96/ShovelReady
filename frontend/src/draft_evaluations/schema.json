          "type": "string"
        },
        "conditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckResult"
