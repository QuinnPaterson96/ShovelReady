            }
          ]
        },
        "diagnostics": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "result": {
          "$ref": "#/$defs/CheckResult"
        }
      },
      "required": [
        "rule",
        "binding",
        "fact",
        "diagnostics",
        "result"
      ],
      "title": "CheckTrace",
      "type": "object"
    },
    "CoordinateReference": {
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "minLength": 1,
