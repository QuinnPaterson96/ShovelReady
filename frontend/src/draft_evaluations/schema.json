        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "page_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Index"
        },
        "printed_page": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Printed Page"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "context": {
          "minLength": 1,
          "title": "Context",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "locator",
        "excerpt",
        "context"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Geometry": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "polygon",
            "line"
          ],
          "title": "Kind",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        },
        "crs": {
          "$ref": "#/$defs/CoordinateReference"
        }
      },
      "required": [
        "kind",
        "coordinates",
        "crs"
      ],
      "title": "Geometry",
      "type": "object"
    },
    "GeometryFact": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
