        "jurisdiction",
        "use",
        "building_role",
        "conditions",
        "exceptions",
        "status"
      ],
      "title": "Applicability",
      "type": "object"
    },
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "$ref": "#/$defs/RevisionRef"
        },
        "fact": {
          "$ref": "#/$defs/RevisionRef"
        },
        "inputs": {
          "$ref": "#/$defs/InputRefs"
        },
        "measurement_definition": {
          "minLength": 1,
          "title": "Measurement Definition",
          "type": "string"
        },
        "definition_support": {
          "enum": [
            "reviewed_direct_measurement",
            "unsupported"
          ],
          "title": "Definition Support",
          "type": "string"
        },
        "applicability": {
          "enum": [
            "applicable",
            "unresolved"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "rule",
        "fact",
        "inputs",
        "measurement_definition",
        "definition_support",
        "applicability",
        "provenance"
      ],
      "title": "Binding",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "pass",
            "supported_failure",
            "missing_fact",
            "extraction_failure",
            "outside_coverage",
            "unsupported_semantics",
            "unresolved_reference",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "missing_facts": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Facts",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "rule",
        "status",
        "explanation",
        "evidence",
        "missing_facts"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "CheckTrace": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "$ref": "#/$defs/RevisionRef"
        },
