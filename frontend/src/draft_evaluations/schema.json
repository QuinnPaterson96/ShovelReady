    },
    "Applicability": {
      "additionalProperties": false,
      "properties": {
        "jurisdiction": {
          "minLength": 1,
          "title": "Jurisdiction",
          "type": "string"
        },
        "use": {
          "minLength": 1,
          "title": "Use",
          "type": "string"
        },
        "building_role": {
          "minLength": 1,
          "title": "Building Role",
          "type": "string"
        },
        "conditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "exceptions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Exceptions",
          "type": "array"
        },
        "status": {
          "enum": [
            "reviewed_scope",
            "unresolved"
          ],
